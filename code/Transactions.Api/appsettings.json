{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailingSettings": {
    "IsEnabled": "true",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSSL": true,
    "UserName": "{YourEmailHere}",
    "Password": "{YourEmailPasswordHere}"
  },
  "AllowedHosts": "*",
  "CustomClaims": {
    "Identity": "UserId"
  }
}
